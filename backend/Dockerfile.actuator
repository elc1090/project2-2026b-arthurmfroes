FROM golang:1.25-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fault-actuator ./cmd/actuator

FROM alpine:3.22
RUN apk add --no-cache ca-certificates openssh-client
COPY --from=build /out/fault-actuator /usr/local/bin/fault-actuator
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/fault-actuator"]
