FROM golang:1.25-alpine AS build

WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/drive-clone ./cmd/server \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fault-signal ./cmd/fault-signal

FROM alpine:3.22 AS init
RUN apk add --no-cache tini-static

FROM cockroachdb/cockroach:v23.2.0
ENV PATH="/cockroach:${PATH}"
USER 10001:10001
WORKDIR /app
COPY --from=init /sbin/tini-static /usr/local/bin/tini
COPY --from=build /out/drive-clone /app/drive-clone
COPY --from=build /out/fault-signal /usr/local/bin/fault-signal
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/tini", "-g", "--", "/app/drive-clone"]
CMD []
